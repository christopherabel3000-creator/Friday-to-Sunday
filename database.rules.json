{
  "rules": {
    "fridayToSundaySaves": {
      "$key": {
        ".read": true,
        ".write": "newData.exists() && ((!data.exists() && newData.child('ver').val() === 1) || (data.exists() && newData.child('ver').val() === data.child('ver').val() + 1))",
        ".validate": "$key.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/) && newData.hasChildren(['ver', 't']) && (newData.hasChild('state') !== newData.hasChild('gone'))",
        "ver": {
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length < 2000000"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() > now - 86400000 && newData.val() < now + 86400000"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length < 64"
        },
        "act": {
          ".validate": "newData.isString() && newData.val().length < 32"
        },
        "gone": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
